<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Happy Kanyaphak Day 🎂💗</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, "Noto Sans Thai", sans-serif;
            background: linear-gradient(135deg, #ffd6e7, #ffeef5);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
            color: #8d4966;
        }

        .page {
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 25px;
        }

        .card {
            width: 100%;
            max-width: 430px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 30px;
            padding: 35px 25px;
            text-align: center;
            box-shadow: 0 10px 35px rgba(214, 112, 150, 0.2);
            position: relative;
            z-index: 2;
        }

        h1 {
            color: #e85d91;
            font-size: 28px;
            margin-bottom: 15px;
        }

        h2 {
            color: #e85d91;
            margin-bottom: 20px;
        }

        p {
            line-height: 1.8;
        }

        .emoji {
            font-size: 55px;
            margin-bottom: 10px;
        }

        input {
            width: 100%;
            padding: 14px;
            border: 2px solid #f4b6ca;
            border-radius: 15px;
            outline: none;
            font-size: 16px;
            text-align: center;
            margin: 15px 0 10px;
        }

        input:focus {
            border-color: #e85d91;
        }

        button {
            width: 100%;
            border: none;
            padding: 14px;
            border-radius: 15px;
            background: #e85d91;
            color: white;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.2s;
        }

        button:hover {
            transform: scale(1.02);
        }

        .error {
            color: #e85d91;
            margin-top: 10px;
            min-height: 25px;
        }

        .hidden {
            display: none !important;
        }

        .letter {
            background: #fff5f9;
            border-radius: 20px;
            padding: 20px;
            margin-top: 20px;
            text-align: left;
            line-height: 1.9;
        }

        .music-btn {
            background: #f49abd;
            margin-top: 20px;
        }

        .floating-heart {
            position: fixed;
            bottom: -30px;
            font-size: 25px;
            animation: floatUp linear forwards;
            z-index: 10;
            pointer-events: none;
        }

        @keyframes floatUp {
            from {
                transform: translateY(0);
                opacity: 1;
            }

            to {
                transform: translateY(-110vh);
                opacity: 0;
            }
        }

        .sparkle {
            font-size: 22px;
        }
    </style>
</head>

<body>

    <!-- หน้าใส่รหัส -->
    <div class="page" id="loginPage">
        <div class="card">

            <div class="emoji">🎂💗</div>

            <h1>Happy Kanyaphak Day</h1>

            <p>
                มีอะไรบางอย่างอยากให้เธอดูนะ 🎀
            </p>

            <input
                type="password"
                id="password"
                placeholder="ใส่รหัสลับ 💗"
            >

            <button onclick="checkPassword()">
                เปิดประตูเซอร์ไพรซ์ 🎁
            </button>

            <div id="error" class="error"></div>

        </div>
    </div>


    <!-- หน้าเซอร์ไพรซ์ -->
    <div class="page hidden" id="surprisePage">
        <div class="card">

            <div class="sparkle">✨ 💗 ✨</div>

            <h1>
                Happy kanyaphak day kub!🎂💗
            </h1>

            <p>
                สุขสันต์วันเกิดนะ 🎀
            </p>

            <button onclick="openLetter()">
                เปิดจดหมาย 💌
            </button>

            <div id="letter" class="letter hidden">

                <h2>ถึง Kanyaphak 💗</h2>

                <p>
                    สุขสันต์วันเกิดนะ โตขึ้นอีกปีแล้ว อายุ 19 แล้วเนอะ
                    ก็ขอให้มีความสุขมากๆ สุขภาพร่างกายแข็งแรง
                    ขอให้ได้เกรดดีดี เจอสังคมที่ดี
                    เป็นที่รักของเพื่อนๆ และอาจารย์
                    ถ้าเหนื่อยก็พัก กินข้าวให้ครบสามมื้อ
                    นอนหลับเต็มอิ่มทุกคืน
                    ขอให้วันเกิดปีนี้เป็นปีที่ดีนะ
                    ดีใจที่ได้เจอครับ
                </p>

                <button class="music-btn" onclick="playMusic()">
                    🎵 เปิดเพลงของเรา 🎵
                </button>

            </div>

        </div>
    </div>


    <script>

        // ตรวจสอบรหัสผ่าน
        function checkPassword() {

            const passwordInput =
                document.getElementById("password");

            const errorMessage =
                document.getElementById("error");

            const password =
                passwordInput.value.trim();

            const correctPassword =
                "231124";


            if (password === correctPassword) {

                document
                    .getElementById("loginPage")
                    .classList.add("hidden");

                document
                    .getElementById("surprisePage")
                    .classList.remove("hidden");

                errorMessage.innerText = "";

                createHearts();

            } else {

                errorMessage.innerText =
                    "รหัสไม่ถูกน้าา ลองใหม่อีกครั้ง 💗";

                passwordInput.value = "";

                passwordInput.focus();
            }
        }


        // เปิดจดหมาย
        function openLetter() {

            document
                .getElementById("letter")
                .classList.remove("hidden");

            createHearts();
        }


        // หัวใจลอย
        function createHearts() {

            for (let i = 0; i < 25; i++) {

                setTimeout(() => {

                    const heart =
                        document.createElement("div");

                    heart.className =
                        "floating-heart";

                    const hearts = [
                        "💗",
                        "💕",
                        "💖",
                        "💓",
                        "🎀",
                        "✨"
                    ];

                    heart.innerText =
                        hearts[
                            Math.floor(
                                Math.random() * hearts.length
                            )
                        ];

                    heart.style.left =
                        Math.random() * 100 + "vw";

                    heart.style.animationDuration =
                        (3 + Math.random() * 4) + "s";

                    document.body.appendChild(heart);

                    setTimeout(() => {
                        heart.remove();
                    }, 7000);

                }, i * 100);
            }
        }


        // เปิดเพลง YouTube
        function playMusic() {

            window.open(
                "https://youtu.be/Sp0rX7MuXnM?si=HMR0ANIKCyQTUap8",
                "_blank"
            );
        }

    </script>

</body>
</html>
